{
  "name": "herconnect",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k -n API,WEB \"node --env-file=.env --watch server/index.js\" \"vite --host 127.0.0.1\"",
    "build": "vite build",
    "start": "node --env-file=.env server/index.js",
    "setup": "node scripts/setup.js",
    "seed": "node --env-file=.env server/seed.js",
    "admin": "node --env-file=.env scripts/admin.js",
    "test": "node --test tests/*.test.js",
    "test:guards": "node --test tests/guards.test.js"
  },
  "dependencies": {
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/dm-sans": "^5.3.0",
    "@tanstack/react-query": "^5.90.0",
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "express": "^5.2.1",
    "express-rate-limit": "^8.2.0",
    "helmet": "^8.1.0",
    "lucide-react": "^0.468.0",
    "mongoose": "^9.0.0",
    "multer": "^2.0.2",
    "nodemailer": "10.0.9",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.10.0",
    "sharp": "0.35.4",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.1.0",
    "concurrently": "^9.2.1",
    "mongodb-memory-server": "^10.4.0",
    "supertest": "^7.2.2",
    "vite": "^7.2.0"
  }
}
