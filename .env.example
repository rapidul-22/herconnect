# Copy with npm run setup, then insert YOUR current MongoDB URI.
MONGODB_URI=mongodb+srv://YOUR_USERNAME:YOUR_PASSWORD@cluster0.spd9gkz.mongodb.net/herconnect_dev?appName=HerConnect
PORT=4000
APP_URL=http://localhost:5173
NODE_ENV=development
# Used only when running npm run admin. Choose a unique password.
ADMIN_EMAIL=admin@herconnect.local
ADMIN_PASSWORD=
# Optional SMTP. With none configured, development reset links print in API terminal.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=HerConnect <no-reply@example.com>
# Seed is opt-in; choose a password for fictional demo accounts before running npm run seed.
DEMO_PASSWORD=
